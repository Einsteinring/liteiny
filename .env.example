# Переменные для функции api/lead.js.
# На Vercel они задаются в Settings → Environment Variables, а не в файле.
# Этот файл — только образец: реальные значения в репозиторий не попадают.

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=""

# Куда приходят заявки. Свой id узнать у @userinfobot,
# id группы отрицательный.
TELEGRAM_CHAT_ID=""

# Необязательно. Адреса, с которых принимаем форму, через запятую.
# Если не задано, берётся список из api/lead.js.
ALLOWED_ORIGINS=""
